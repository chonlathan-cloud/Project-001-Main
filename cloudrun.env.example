GCP_PROJECT_ID=project001-489710
GCP_REGION=asia-southeast1
ARTIFACT_REPO=projects-001
DOCKER_PLATFORM=linux/amd64

BACKEND_SERVICE_NAME=Projects-001-BE
BACKEND_IMAGE_NAME=projects-001-be
BACKEND_SOURCE_DIR=Projects-001-BE
BACKEND_ENV_FILE=cloudrun-backend.env.yaml
BACKEND_ALLOW_UNAUTHENTICATED=true
BACKEND_SERVICE_ACCOUNT=backend-runtime@project001-489710.iam.gserviceaccount.com
BACKEND_CLOUDSQL_INSTANCE=project001-489710:asia-southeast1:project-001
# Map portal-specific LINE values from Secret Manager during backend deployment.
# BACKEND_SECRET_ENV_VARS=LINE_SUBCONTRACTOR_CHANNEL_ID=LINE_SUBCONTRACTOR_CHANNEL_ID:latest,LINE_SUBCONTRACTOR_CHANNEL_SECRET=LINE_SUBCONTRACTOR_CHANNEL_SECRET:latest,LINE_SUBCONTRACTOR_CHANNEL_ACCESS_TOKEN=LINE_SUBCONTRACTOR_CHANNEL_ACCESS_TOKEN:latest,LINE_SUBCONTRACTOR_LIFF_ID=LINE_SUBCONTRACTOR_LIFF_ID:latest,LINE_CUSTOMER_CHANNEL_ID=LINE_CUSTOMER_CHANNEL_ID:latest,LINE_CUSTOMER_CHANNEL_SECRET=LINE_CUSTOMER_CHANNEL_SECRET:latest,LINE_CUSTOMER_CHANNEL_ACCESS_TOKEN=LINE_CUSTOMER_CHANNEL_ACCESS_TOKEN:latest,LINE_CUSTOMER_LIFF_ID=LINE_CUSTOMER_LIFF_ID:latest
BACKEND_MEMORY=1Gi
BACKEND_CPU=1
BACKEND_MIN_INSTANCES=0
BACKEND_MAX_INSTANCES=3

FRONTEND_SERVICE_NAME=Projects-001-FE
FRONTEND_IMAGE_NAME=projects-001-fe
FRONTEND_SOURCE_DIR=Projects-001-FE
FRONTEND_BUILD_ENV_FILE=cloudrun-frontend.build.env
FRONTEND_ALLOW_UNAUTHENTICATED=true
FRONTEND_SERVICE_ACCOUNT=backend-runtime@project001-489710.iam.gserviceaccount.com
# When the portal-specific VITE values are absent from the build env file,
# deploy_frontend.sh reads these LIFF IDs from Secret Manager without printing them.
FRONTEND_LINE_SUBCONTRACTOR_LIFF_SECRET=LINE_SUBCONTRACTOR_LIFF_ID
FRONTEND_LINE_CUSTOMER_LIFF_SECRET=LINE_CUSTOMER_LIFF_ID
FRONTEND_MEMORY=512Mi
FRONTEND_CPU=1
FRONTEND_MIN_INSTANCES=0
FRONTEND_MAX_INSTANCES=3
